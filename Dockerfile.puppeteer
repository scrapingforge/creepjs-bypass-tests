FROM node:23-slim

# Install Xvfb, Chromium, and dependencies
RUN apt-get update && apt-get install -y \
    chromium \
    xvfb \
    x11vnc \
    x11-utils \
    fluxbox \
    dbus-x11 \
    fonts-liberation \
    fonts-noto-color-emoji \
    libnss3 \
    libxss1 \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libu2f-udev \
    libvulkan1 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV DISPLAY=:99

# Create startup script with Xvfb
RUN echo '#!/bin/bash\n\
set -e\n\
rm -f /tmp/.X99-lock /tmp/.X11-unix/X99\n\
dbus-daemon --system --fork 2>/dev/null || true\n\
Xvfb :99 -screen 0 1920x1080x24 -ac +extension GLX +render -noreset &\n\
XVFB_PID=$!\n\
for i in {1..10}; do\n\
  if xdpyinfo -display :99 >/dev/null 2>&1; then\n\
    break\n\
  fi\n\
  sleep 1\n\
done\n\
export DISPLAY=:99\n\
exec node src/puppeteer-scraper.js' > /start.sh && chmod +x /start.sh

CMD ["/start.sh"]
