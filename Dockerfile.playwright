FROM mcr.microsoft.com/playwright:v1.56.1-noble

# Install Xvfb and dependencies
RUN apt-get update && apt-get install -y \
    xvfb \
    x11vnc \
    fluxbox \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ENV DISPLAY=:99

# Create startup script with Xvfb
RUN echo '#!/bin/bash\n\
rm -f /tmp/.X99-lock\n\
Xvfb :99 -screen 0 1920x1080x24 -ac +extension GLX +render -noreset &\n\
sleep 2\n\
exec node src/playwright-scraper.js' > /start.sh && chmod +x /start.sh

CMD ["/start.sh"]
